// Platform (control-plane) database schema for a single-college deployment.
//
// One deployment serves exactly one college: its own server, its own domain,
// its own pair of databases. Onboarding a new college means standing up a new
// deployment, not adding a row here — so there is no college registry, no
// tenant routing and no stored connection strings anywhere in this file.
//
// What this database holds is the configuration the platform owner controls
// and the college does not:
//
//   * College       — the singleton profile of the college being served
//   * Module        — the catalog of modules that exist in this ERP
//   * ModuleAccess  — which of them this college has been granted (Layer 1)
//   * PlatformUser  — the platform owner's own Super Admin login
//
// The college's operational data — students, staff, fees, its own users and
// roles — lives in the separate college database (prisma/college/schema.prisma),
// reached through COLLEGE_DATABASE_URL. Keeping the two apart means a college
// user's session can never touch the switches that decide what they are
// allowed to see.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

// Platform-level role. Distinct from the college's own roles: being a
// platform admin grants no automatic access to the college's academic or
// financial data — only the authority to grant and revoke modules.
enum PlatformRole {
  SUPER_ADMIN
}

// ─────────────────────────────────────────────────────────────────────────
// The college this deployment serves
// ─────────────────────────────────────────────────────────────────────────

// A singleton. `id` defaults to a constant rather than a cuid so every write
// is an upsert against the same row and a second college physically cannot
// be created here — the deployment boundary is what separates colleges, and
// a stray second row would quietly reintroduce the multi-tenancy this
// architecture exists to avoid.
//
// Seeded from environment variables at deploy time (prisma/seed.ts), which
// is why name/code are set rather than entered through a UI: the college's
// identity is part of the deployment, not something configured after it.
model College {
  id        String   @id @default("college")
  code      String   @unique
  name      String
  logoUrl   String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  website   String?
  // Cuts off every college login at once without touching their data —
  // for a deployment that is being wound down or is between contracts.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Module catalog & grants
// ─────────────────────────────────────────────────────────────────────────

// Every module this ERP ships, mirrored from lib/permissions.ts by the seed.
// Being in this catalog is necessary but not sufficient for access — the
// college only sees a module once ModuleAccess marks it enabled.
model Module {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  icon        String?
  version     String   @default("1.0.0")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  dependsOn  ModuleDependency[] @relation("ModuleDependsOn")
  dependents ModuleDependency[] @relation("ModuleDependents")
  access     ModuleAccess?
}

model ModuleDependency {
  id              String @id @default(cuid())
  moduleId        String
  module          Module @relation("ModuleDependsOn", fields: [moduleId], references: [id], onDelete: Cascade)
  dependsOnId     String
  dependsOnModule Module @relation("ModuleDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([moduleId, dependsOnId])
}

// Layer 1 access control: has this deployment's college been granted this
// module at all? Controlled exclusively by the platform Super Admin.
//
// One row per module, not per (college, module) — there is only one college
// here, so `moduleId` is the natural key. Disabling sets `enabled = false`
// rather than deleting the row, so the audit trail of who turned what off
// and when survives.
//
// Layer 2 — which of the college's own users may do what inside an enabled
// module — is the College Admin's business and lives in the college
// database's Role/RolePermission tables.
model ModuleAccess {
  id          String    @id @default(cuid())
  moduleId    String    @unique
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  enabled     Boolean   @default(false)
  enabledAt   DateTime?
  enabledById String?
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Platform admins & audit log
// ─────────────────────────────────────────────────────────────────────────

// The platform owner's login for this deployment. A completely separate
// identity space from the college's users, which live in the college
// database — deliberately not the same model, so no college user can ever
// be escalated into a Super Admin by editing a column.
model PlatformUser {
  id                 String       @id @default(cuid())
  username           String       @unique
  email              String?      @unique
  passwordHash       String
  name               String
  phone              String?
  platformRole       PlatformRole
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  auditLogs PlatformAuditLog[]
}

// What the platform owner did to this deployment: module grants and
// revocations, College Admin password reissues, sign-ins. Separate from the
// college's own audit log (which lives in the college database) because the
// two answer to different people.
model PlatformAuditLog {
  id        String        @id @default(cuid())
  userId    String?
  user      PlatformUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([module, recordId])
  @@index([userId])
  @@index([createdAt])
}
