// Platform (control-plane) database schema.
//
// This database stores ONLY platform/tenant metadata — colleges, the module
// catalog, subscriptions, and platform admins. It must never contain a
// college's students/staff/academic/financial records: those live in that
// college's own database (see prisma/tenant/schema.prisma), reachable only
// through the encrypted connection string stored on College.
//
// TenantUserDirectory exists purely so the single login form can figure out
// *which* tenant database to check a username against before it can prove
// who the user is (tenant databases are not cross-queryable, so this tiny
// index — not the real user record — is what makes routing possible).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

// Platform-level role. Distinct from tenant roles: being a platform admin
// grants no automatic access to any college's academic/business data
// (spec section 27 / 34) — only platform (tenant/module/subscription)
// management authority.
enum PlatformRole {
  SUPER_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
}

enum TenantStatus {
  CREATED
  PROVISIONING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────────────────
// Tenants
// ─────────────────────────────────────────────────────────────────────────

model College {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  logoUrl   String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  website   String?
  status    TenantStatus @default(ACTIVE)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Encrypted at rest (lib/tenant-db.ts) — this college's own database
  // connection string. Never sent to the frontend after it's saved.
  databaseUrlEncrypted String

  tenantModules TenantModule[]
  subscriptions Subscription[]
  auditLogs     PlatformAuditLog[]
  userDirectory TenantUserDirectory[]
}

// ─────────────────────────────────────────────────────────────────────────
// Module marketplace
// ─────────────────────────────────────────────────────────────────────────

// The platform's module catalog. A college only gets a nav entry / API
// access for a module once a TenantModule row marks it enabled — a module
// existing in this catalog is necessary but not sufficient for access.
model Module {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  icon        String?
  version     String   @default("1.0.0")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  dependsOn     ModuleDependency[] @relation("ModuleDependsOn")
  dependents    ModuleDependency[] @relation("ModuleDependents")
  tenantModules TenantModule[]
  planModules   PlanModule[]
}

model ModuleDependency {
  id              String @id @default(cuid())
  moduleId        String
  module          Module @relation("ModuleDependsOn", fields: [moduleId], references: [id], onDelete: Cascade)
  dependsOnId     String
  dependsOnModule Module @relation("ModuleDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([moduleId, dependsOnId])
}

// Layer 1 access control: does this college have this module at all?
// Controlled exclusively by the Platform Super Admin (spec section 6).
model TenantModule {
  id          String    @id @default(cuid())
  collegeId   String
  college     College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  enabled     Boolean   @default(false)
  enabledAt   DateTime?
  enabledById String?

  @@unique([collegeId, moduleId])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  planModules   PlanModule[]
  subscriptions Subscription[]
}

model PlanModule {
  id       String @id @default(cuid())
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
}

model Subscription {
  id        String             @id @default(cuid())
  collegeId String
  college   College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?

  @@index([collegeId])
}

// ─────────────────────────────────────────────────────────────────────────
// Platform admins & audit log
// ─────────────────────────────────────────────────────────────────────────

// The platform owner's own staff. Completely separate identity space from
// any college's users (spec section 16) — deliberately not the same model.
model PlatformUser {
  id                 String        @id @default(cuid())
  username           String        @unique
  email              String?       @unique
  passwordHash       String
  name               String
  phone              String?
  platformRole       PlatformRole
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(true)
  createdById        String?
  createdBy          PlatformUser? @relation("PlatformUserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       PlatformUser[] @relation("PlatformUserCreatedBy")
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  auditLogs PlatformAuditLog[]
}

model PlatformAuditLog {
  id        String        @id @default(cuid())
  userId    String?
  user      PlatformUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  // The college a platform action concerned (e.g. "enabled module X"),
  // null for pure platform actions (e.g. "created a plan").
  collegeId String?
  college   College?      @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  action    String
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([module, recordId])
  @@index([userId])
  @@index([collegeId])
  @@index([createdAt])
}

// Login-routing index only — see file header. The authoritative user record
// lives in the tenant's own database.
model TenantUserDirectory {
  id        String   @id @default(cuid())
  username  String   @unique
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([collegeId])
}
